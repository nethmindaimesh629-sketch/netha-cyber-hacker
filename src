const json = (data, status = 200) =>
  new Response(JSON.stringify(data), {
    status,
    headers: { "content-type": "application/json; charset=utf-8", "cache-control": "no-store" }
  });

const enc = new TextEncoder();
const toB64Url = (bytes) => btoa(String.fromCharCode(...new Uint8Array(bytes)))
  .replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/g, "");
const fromB64Url = (s) => Uint8Array.from(atob(s.replace(/-/g, "+").replace(/_/g, "/") + "===".slice((s.length + 3) % 4)), c => c.charCodeAt(0));

async function sha256(text) {
  const digest = await crypto.subtle.digest("SHA-256", enc.encode(text));
  return [...new Uint8Array(digest)].map(b => b.toString(16).padStart(2, "0")).join("");
}
async function sign(value, secret) {
  const key = await crypto.subtle.importKey("raw", enc.encode(secret), { name: "HMAC", hash: "SHA-256" }, false, ["sign"]);
  return toB64Url(await crypto.subtle.sign("HMAC", key, enc.encode(value)));
}
async function makeSession(secret) {
  const payload = toB64Url(enc.encode(JSON.stringify({ exp: Date.now() + 8 * 60 * 60 * 1000 })));
  return payload + "." + await sign(payload, secret);
}
async function isAdmin(request, env) {
  const cookie = request.headers.get("Cookie") || "";
  const match = cookie.match(/(?:^|;\s*)netha_admin=([^;]+)/);
  if (!match) return false;
  const parts = match[1].split(".");
  if (parts.length !== 2) return false;
  const expected = await sign(parts[0], env.SESSION_SECRET || "");
  if (!env.SESSION_SECRET || expected !== parts[1]) return false;
  try {
    const payload = JSON.parse(new TextDecoder().decode(fromB64Url(parts[0])));
    return payload.exp > Date.now();
  } catch { return false; }
}
const cookieHeaders = (value, maxAge) => ({
  "set-cookie": `netha_admin=${value}; HttpOnly; Secure; SameSite=Strict; Path=/; Max-Age=${maxAge}`,
  "cache-control": "no-store"
});
function randomKey() {
  const bytes = crypto.getRandomValues(new Uint8Array(18));
  return "NETHA-" + [...bytes].map(b => "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"[b % 32]).join("");
}
async function bodyJson(request) {
  try { return await request.json(); } catch { return null; }
}

export default {
  async fetch(request, env) {
    const url = new URL(request.url);
    if (url.pathname.startsWith("/api/")) {
      if (request.method !== "POST") return json({ error: "Method not allowed" }, 405);
      const body = await bodyJson(request);
      if (!body) return json({ error: "Invalid request" }, 400);

      if (url.pathname === "/api/admin/login") {
        if (!env.ADMIN_PASSWORD || !env.SESSION_SECRET) return json({ error: "Server secrets are not configured." }, 500);
        const password = String(body.password || "");
        if (password.length > 256 || password !== env.ADMIN_PASSWORD) {
          return json({ error: "Incorrect admin password." }, 401);
        }
        const session = await makeSession(env.SESSION_SECRET);
        return new Response(JSON.stringify({ ok: true }), {
          headers: { "content-type": "application/json", ...cookieHeaders(session, 8 * 60 * 60) }
        });
      }

      if (url.pathname === "/api/admin/logout") {
        return new Response(JSON.stringify({ ok: true }), {
          headers: { "content-type": "application/json", ...cookieHeaders("", 0) }
        });
      }

      if (!(await isAdmin(request, env))) return json({ error: "Admin login required." }, 401);

      if (url.pathname === "/api/admin/create") {
        const label = String(body.label || "").trim().slice(0, 60);
        const key = randomKey();
        const now = Date.now();
        const expires = now + 30 * 24 * 60 * 60 * 1000;
        await env.DB.prepare(
          "INSERT INTO access_keys (key_hash, label, created_at, expires_at, disabled) VALUES (?, ?, ?, ?, 0)"
        ).bind(await sha256(key), label, now, expires).run();
        return json({ ok: true, key, expiresAt: expires });
      }

      if (url.pathname === "/api/admin/list") {
        const result = await env.DB.prepare(
          "SELECT id, label, created_at AS createdAt, expires_at AS expiresAt, disabled FROM access_keys ORDER BY id DESC LIMIT 200"
        ).all();
        const now = Date.now();
        return json({ ok: true, keys: (result.results || []).map(k => ({
          ...k, status: k.disabled ? "Disabled" : (k.expiresAt <= now ? "Expired" : "Active")
        })) });
      }

      if (url.pathname === "/api/admin/disable") {
        const id = Number(body.id);
        if (!Number.isInteger(id) || id <= 0) return json({ error: "Invalid key ID." }, 400);
        const result = await env.DB.prepare("UPDATE access_keys SET disabled = 1 WHERE id = ?").bind(id).run();
        if (!result.meta?.changes) return json({ error: "Key not found." }, 404);
        return json({ ok: true });
      }
      return json({ error: "Not found." }, 404);
    }

    if (url.pathname === "/api/verify") {
      if (request.method !== "POST") return json({ error: "Method not allowed" }, 405);
      const body = await bodyJson(request);
      if (!body) return json({ error: "Invalid request." }, 400);
      const key = String(body.key || "").trim().toUpperCase();
      if (!key || key.length > 100) return json({ error: "Enter a valid access key." }, 400);
      const row = await env.DB.prepare(
        "SELECT expires_at AS expiresAt, disabled FROM access_keys WHERE key_hash = ?"
      ).bind(await sha256(key)).first();
      if (!row) return json({ error: "INVALID ACCESS KEY" }, 401);
      if (row.disabled) return json({ error: "KEY DISABLED" }, 403);
      if (row.expiresAt <= Date.now()) return json({ error: "KEY EXPIRED" }, 403);
      return json({ ok: true, message: "ACCESS GRANTED" });
    }

    return env.ASSETS.fetch(request);
  }
};
